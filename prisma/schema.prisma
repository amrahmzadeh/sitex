generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String?
  passwordHash        String
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Super Admin & platform fields
  role                UserRole     @default(USER)
  status              UserStatus   @default(ACTIVE)
  subscriptionExpiry  DateTime?    // null = unlimited
  maxSites            Int?         // null = unlimited

  memberships         Membership[]
  auditLogs           AuditLog[]   @relation("AuditActor")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model Membership {
  id             String       @id @default(cuid())
  role           Role         @default(OWNER)
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
}

// ==================== ORGANIZATION (TENANT) ====================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  phone       String?
  email       String?
  address     String?
  city        String?
  mapUrl      String?
  currency    String   @default("AZN")

  // Sayt növü (kateqoriya / alt kateqoriya ID-ləri) və tətbiq olunmuş şablon
  // Köhnə saytlar üçün nullable-dir — geriyə uyğunluq qorunur.
  siteCategory      String?
  siteSubcategory   String?
  templateId        String?
  templateVersion   String?
  templateSource    String?   // "github" | "builtin"
  templateAppliedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships      Membership[]
  website          Website?
  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  mediaAssets      MediaAsset[]
  whatsappSettings WhatsAppSettings?
  socialLinks      SocialLink[]
  workingHoursSettings WorkingHoursSettings?
  workingHours     WorkingHours[]
  qrSettings       QRSettings?
  socialFeedPosts  SocialFeedPost[]
  galleryItems     GalleryItem[]
  packages         Package[]
  contactSubmissions ContactSubmission[]
  siteContents     SiteContent[]
}

// ==================== QR SETTINGS ====================

model QRSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  tableCount      Int          @default(10)
  designConfig    String       @db.Text @default("{}")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==================== WEBSITE & THEME ====================

model Website {
  id             String   @id @default(cuid())
  organizationId String   @unique
  isPublished    Boolean  @default(false)
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Draft theme config (JSON)
  draftTheme     Json     @default("{}")
  // Published theme config (JSON)  
  publishedTheme Json     @default("{}")

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImage        String?

  // Pages config
  pagesConfig    Json     @default("[]")
  publishedPages Json     @default("[]")
  moduleSettings Json     @default("{}")

  // Splash screen
  splashEnabled  Boolean  @default(false)
  splashConfig   Json     @default("{}")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==================== MENU ====================

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  image          String?
  sortOrder      Int          @default(0)
  isVisible      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems      MenuItem[]

  @@unique([organizationId, slug])
}

model MenuItem {
  id             String          @id @default(cuid())
  organizationId String
  categoryId     String
  name           String
  slug           String
  description    String?
  longDescription String?
  price          Float
  discountPrice  Float?
  image          String?
  video          String?
  ingredients    String?
  allergens      String?
  portionSize    String?
  prepTime       String?
  isFeatured     Boolean         @default(false)
  isNew          Boolean         @default(false)
  isPopular      Boolean         @default(false)
  isVisible      Boolean         @default(true)
  sortOrder      Int             @default(0)
  seoTitle       String?
  seoDescription String?
  isSet          Boolean         @default(false)
  setItems       String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images         MenuItemImage[]

  @@unique([organizationId, slug])
}

model MenuItemImage {
  id         String   @id @default(cuid())
  menuItemId String
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ==================== MEDIA ====================

model MediaAsset {
  id             String       @id @default(cuid())
  organizationId String
  filename       String
  url            String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  alt            String?
  data           String?      @db.LongText
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ==================== SETTINGS ====================

model WhatsAppSettings {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  countryCode     String       @default("+994")
  phoneNumber     String
  orderMessage    String       @default("Salam! Bu məhsulu sifariş etmək istəyirəm:")
  buttonText      String       @default("WhatsApp ilə sifariş et")
  contactNumber   String?
  isEnabled       Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SocialLink {
  id             String       @id @default(cuid())
  organizationId String
  platform       String       // instagram, facebook, tiktok, youtube, etc.
  url            String
  sortOrder      Int          @default(0)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WorkingHoursSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  timezone                String       @default("Asia/Baku")
  pauseOrdersOutsideHours Boolean      @default(false)
  offHoursMessage         String?      @db.Text
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model WorkingHours {
  id             String       @id @default(cuid())
  organizationId String
  dayOfWeek      Int          // 0=Sunday, 6=Saturday
  openTime       String?      // "09:00"
  closeTime      String?      // "22:00"
  isClosed       Boolean      @default(false)
  breakStart     String?
  breakEnd       String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dayOfWeek])
}

// ==================== PLATFORM SETTINGS ====================

model PlatformSettings {
  id                    String   @id @default(cuid())
  key                   String   @unique
  value                 String   @db.Text
  updatedAt             DateTime @updatedAt
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actor       User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  action      String   // e.g. BAN_USER, DELETE_SITE, CHANGE_SUBSCRIPTION
  targetType  String   // USER, SITE
  targetId    String
  meta        String?  @db.Text
  createdAt   DateTime @default(now())
}

// ==================== SITE → GITHUB SYNC ====================

enum SiteSyncStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Hər saytın GitHub-a sinxronizasiyası üçün növbə qeydi.
// siteId bilərəkdən relation deyil: sayt silindikdə də job qalır və
// GitHub-da soft-delete commit-i yaza bilir.
model SiteSyncJob {
  id          String         @id @default(cuid())
  siteId      String
  status      SiteSyncStatus @default(PENDING)
  trigger     String         @default("publish") // create | publish | manual | backfill | delete
  attempts    Int            @default(0)
  lastError   String?        @db.Text
  commitSha   String?
  contentHash String?
  noChanges   Boolean        @default(false)
  requestedBy String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([siteId, createdAt])
  @@index([status, createdAt])
}

// ==================== SOCIAL FEED POSTS ====================

model SocialFeedPost {
  id              String       @id @default(cuid())
  organizationId  String
  platform        String       // instagram, tiktok, youtube, facebook
  postUrl         String       // Original post URL
  // Fetched via oEmbed / stored locally
  thumbnailUrl    String?      // Post image/thumbnail
  caption         String?      @db.Text
  authorName      String?
  authorHandle    String?
  authorAvatar    String?
  likes           Int          @default(0)
  comments        Int          @default(0)
  isVideo         Boolean      @default(false)
  sortOrder       Int          @default(0)
  isVisible       Boolean      @default(true)
  fetchedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


// ==================== CONTACT FORM SUBMISSIONS / INQUIRIES ====================

model ContactSubmission {
  id              String                  @id @default(cuid())
  organizationId  String
  fullName        String
  email           String?
  phone           String?
  service         String?
  subject         String?
  message         String                  @db.Text
  status          ContactSubmissionStatus @default(NEW)
  notes           String?                 @db.Text
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
}

enum ContactSubmissionStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}


// ==================== GALLERY ====================

model GalleryItem {
  id             String       @id @default(cuid())
  organizationId String
  url            String       @db.Text
  title          String?
  description    String?      @db.Text
  sortOrder      Int          @default(0)
  isVisible      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
}

// ==================== SITE CONTENT (Saytı Redaktə et modulu) ====================

// Hər saytın blok məzmunu: hero, about, contact, menyu başlığı, qalareya, rezervasiya.
// draftContent → istifadəçi redaktə edir; publishedContent → canlı saytda göstərilir.
// version → hər yayımda artır (history üçün).
model SiteContent {
  id               String       @id @default(cuid())
  organizationId   String
  pageKey          String       // "hero" | "about" | "contact" | "menu" | "gallery" | "reservation"
  blockKey         String       // "hero.main" | "about.story" vb.
  draftContent     Json         @default("{}")   // ContentDoc { fields, visible, sortOrder }
  publishedContent Json         @default("{}")
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pageKey, blockKey])
  @@index([organizationId])
}

// Versiya tarixçəsi — "Default-a qaytar" üçün snapshot saxlanır.
model SiteContentHistory {
  id             String   @id @default(cuid())
  organizationId String
  pageKey        String
  blockKey       String
  content        Json     // ContentDoc snapshot
  version        Int
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, pageKey, blockKey, createdAt])
}

// ==================== PACKAGES ====================

model Package {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  title           String?
  description     String?      @db.Text
  fullDescription String?      @db.Text
  price           Float?
  discountPrice   Float?
  image           String?      @db.Text
  features        Json         @default("[]")
  tag             String?
  badgeText       String?
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, sortOrder])
}
